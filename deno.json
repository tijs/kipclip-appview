{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/348900b8b79f4a434cab4c74b3bc8d4d2fa8ee74/cli/schemas/config-file.v1.json",
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.13",
    "@std/assert": "jsr:@std/assert@1",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/dotenv": "jsr:@std/dotenv@0.225",
    "@std/media-types": "jsr:@std/media-types@1",
    "@std/path": "jsr:@std/path@1",
    "@tijs/atproto-oauth": "jsr:@tijs/atproto-oauth@2.10.2",
    "@tijs/atproto-sessions": "jsr:@tijs/atproto-sessions@2.1.0",
    "@tijs/atproto-storage": "jsr:@tijs/atproto-storage@1.2.0",
    "@tijs/oauth-client-deno": "jsr:@tijs/oauth-client-deno@5.1.0",
    "@libsql/client": "npm:@libsql/client@0.17.3",
    "@sentry/deno": "npm:@sentry/deno@10.34.0",
    "esbuild": "npm:esbuild@0.28.1",
    "html-entities": "npm:html-entities@2.6.0",
    "ws": "npm:ws@8.21.0",
    "react": "npm:react@19.2.3",
    "react-dom": "npm:react-dom@19.2.3",
    "react-dom/client": "npm:react-dom@19.2.3/client",
    "sonner": "npm:sonner@2"
  },
  "compilerOptions": {
    "noImplicitAny": false,
    "strict": false,
    "jsx": "react-jsx",
    "jsxImportSource": "npm:react@19",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "include": [
    "lib/",
    "frontend/",
    "shared/",
    "tests/",
    "scripts/",
    "runtime/",
    "routes/",
    "main.ts",
    "dev.ts"
  ],
  "nodeModulesDir": "none",
  "unstable": [
    "kv"
  ],
  "experimental": {
    "unstable-node-globals": true,
    "unstable-temporal": true,
    "unstable-worker-options": true,
    "unstable-sloppy-imports": true
  },
  "exclude": [
    "static/",
    "dist/",
    "node_modules/",
    "tests/fixtures/"
  ],
  "tasks": {
    "build:frontend": "deno run -A scripts/build-frontend.ts",
    "dev": "deno run -A --unstable-kv scripts/dev.ts",
    "build": "deno task build:frontend && deno task check",
    "build:portable": "deno bundle --node-modules-dir=none --platform=browser --format=esm --keep-names --output=dist/application.mjs runtime/portable.ts",
    "build:all": "deno task build && deno task build:portable",
    "start:node": "node runtime/node/server.mjs",
    "start:bun": "bun runtime/bun/server.mjs",
    "test:runtime:deno": "deno run --cached-only -A --unstable-kv tests/runtime/contracts.mjs",
    "test:runtime:node": "node tests/runtime/contracts.mjs",
    "test:runtime:bun": "bun tests/runtime/contracts.mjs",
    "start": "deno run -A --unstable-kv runtime/deno/server.ts",
    "preview": "deno task start",
    "quality": "deno fmt --check && deno lint && deno task audit:framework && deno task audit:runtime && deno task audit && deno task check && deno task check:frontend",
    "audit": "deno run -A scripts/audit.ts",
    "audit:framework": "deno run --allow-read scripts/audit-framework.ts",
    "audit:runtime": "deno run --allow-read scripts/audit-runtime.ts",
    "audit:native": "npm audit --omit=dev",
    "audit:fix": "deno audit --fix",
    "check": "deno check --allow-import main.ts runtime/deno/server.ts",
    "check:frontend": "deno run -A scripts/check-frontend.ts",
    "test": "SENTRY_DSN= KIPCLIP_TESTING=1 KIPCLIP_MANIFEST_PATH=tests/fixtures/manifest.test.json DATABASE_URL=file::memory: COOKIE_SECRET=test-cookie-secret-32-characters-minimum ENCRYPTION_KEY=test-encryption-key-for-unit-tests-only-minimum-32-chars deno test --allow-all --unstable-kv tests/",
    "test:watch": "SENTRY_DSN= KIPCLIP_TESTING=1 KIPCLIP_MANIFEST_PATH=tests/fixtures/manifest.test.json DATABASE_URL=file::memory: COOKIE_SECRET=test-cookie-secret-32-characters-minimum deno test --allow-all --unstable-kv --watch",
    "fmt": "deno fmt",
    "lint": "deno lint"
  }
}
