[Unit]
Description=TAP weekly auto-update (immutable pinned base sha + reviewed kipclip downstream patches)

[Timer]
# Weekly cadence — TAP is built from an immutable reviewed base sha plus the
# kipclip-owned downstream patch set (deploy/tap/README.md): upstream has no
# release rhythm, and origin/main is intentionally never tracked (pinning a
# moving branch is how the retry-storm build silently changed under us).
# Sunday 04:00 UTC is low-traffic for kipclip and gives a quiet window
# for the rebuild + restart + health-check cycle.
OnCalendar=Sun *-*-* 04:00:00 UTC
# Catch missed runs if the box was offline at the scheduled time.
Persistent=true
# Spread firing slightly so a fleet of boxes wouldn't stampede a Hetzner
# upstream mirror simultaneously (purely defensive — current fleet = 1).
RandomizedDelaySec=15min
Unit=tap-update.service

[Install]
WantedBy=timers.target
