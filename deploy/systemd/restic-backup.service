[Unit]
Description=kipclip restic backup (Turso dump + local mirror snapshot + TAP state)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root: /etc/kipclip/restic.env is root:root 0600 (enforced by
# check-env-perms.sh) and restic-backup.sh sources it — a non-root user
# gets "Permission denied" every run. Keep User/Group in sync with the
# root-owned 0600 secret contract; ReadWritePaths below still scopes
# writes to the data dirs and NoNewPrivileges stays on.
User=root
Group=root
ExecStart=/var/lib/kipclip/current/deploy/restic-backup.sh
EnvironmentFile=/etc/kipclip/restic.env

# Hardening — restic + sqlite3 only need /tmp + /var/lib/kipclip + /var/lib/tap.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kipclip /var/lib/tap /tmp

# Failure handling: non-zero exit propagates to journald. Pair with a Sentry
# wrapper or `OnFailure=` unit if first-class alerting is needed; for now,
# `systemctl status restic-backup` after each run is the operator signal.
