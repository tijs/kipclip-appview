[Unit]
Description=kipclip mirror-drift alert (audit tracked DIDs vs PDS, Sentry on diff)
After=network-online.target kipclip.service
Wants=network-online.target

[Service]
Type=oneshot
User=kipclip
Group=kipclip
WorkingDirectory=/var/lib/kipclip/current
EnvironmentFile=/etc/kipclip/env
ExecStart=/opt/deno/bin/deno run --allow-net --allow-env --allow-read --allow-write --allow-sys --allow-ffi scripts/drift-alert.ts --quiet

# Hardening — script only reads tracked_dids + bookmarks and POSTs to PDS+Sentry.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kipclip

# Drift / PDS errors are signals, not successes. Since v0.24.38:
#   exit 0 = clean run
#   exit 1 = recoverable drift detected (must be REPORTED as non-clean)
#   exit 2 = audit failed entirely
#   exit 3 = classified PDS errors present (nothing auto-repaired)
# Only exit 0 counts as a successful clean run — drift (1) and PDS errors (3)
# must surface in `systemctl status`/`Result=failed` + ExecMainStatus, and
# the weekly report reads ExecMainStatus, never Result alone.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
