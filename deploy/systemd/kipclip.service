[Unit]
Description=kipclip Deno app (Hono)
After=network.target

[Service]
Type=simple
User=kipclip
Group=kipclip
WorkingDirectory=/var/lib/kipclip/current
EnvironmentFile=/etc/kipclip/env
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/opt/deno/bin/deno run -A --unstable-kv runtime/deno/server.ts
Restart=always
RestartSec=2s
# Deno waits for long-lived WebSocket connections during graceful shutdown.
# Bound release/reboot downtime before systemd force-closes them.
TimeoutStopSec=10s

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kipclip /var/log/kipclip

[Install]
WantedBy=multi-user.target
